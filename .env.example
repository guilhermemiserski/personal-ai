# API (apps/api ou docker-compose)
# Dev sem Docker: SQLite (padrão). Produção: Postgres abaixo.
DATABASE_URL=sqlite+aiosqlite:///./personal_ai.db
# DATABASE_URL=postgresql+asyncpg://personal_ai:personal_ai@localhost:5432/personal_ai
JWT_SECRET=troque-isso-em-producao
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
GROQ_REQUEST_TIMEOUT_SECONDS=22
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false
WGER_BASE_URL=https://wger.de
WGER_LANGUAGE_ID=7

# Web (apps/web) — /api is proxied to the API by Next.js (see next.config.ts)
API_PROXY_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=/api
